# Copy to .env and set a long, unique password.
ACCUFOLIO_USER=admin
ACCUFOLIO_PASSWORD=replace-with-a-strong-unique-password
# Set this to your public HTTPS origin when using a separate reverse proxy.
# compose.https.yml supplies it automatically from ACCUFOLIO_DOMAIN.
ACCUFOLIO_PUBLIC_ORIGIN=
# Optional login and maintenance policy.
ACCUFOLIO_LOGIN_MAX_ATTEMPTS=10
ACCUFOLIO_LOGIN_COOLDOWN=300
ACCUFOLIO_MAINTENANCE_INTERVAL=300
ACCUFOLIO_BACKUP_KEEP=30
