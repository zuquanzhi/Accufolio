# Copy to .env and set a long, unique password.
ACCUFOLIO_USER=admin
ACCUFOLIO_PASSWORD=replace-with-a-strong-unique-password
# Optional: new alerts are delivered as JSON POSTs. Empty disables all Webhook traffic.
# HTTPS only; redirects are rejected. Keep these values private.
ACCUFOLIO_WEBHOOK_URL=
# Optional Authorization: Bearer token. Do not paste secrets into the application UI.
ACCUFOLIO_WEBHOOK_TOKEN=
